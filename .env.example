# Copy to .env and edit. Every value is optional except a password you choose.

# ── login for the phone app ─────────────────────────────
OCB_USERNAME=me
OCB_PASSWORD=change-me-to-something-long
# How long a phone stays logged in.
OCB_SESSION_DAYS=30

# ── where the bridge listens ────────────────────────────
# Keep 127.0.0.1 and put Tailscale Serve (HTTPS) in front; see README.
OCB_HOST=127.0.0.1
OCB_PORT=7878
# Set to 1 when the app is reached over HTTPS (Tailscale Serve, Caddy…).
OCB_SECURE_COOKIES=1

# ── the opencode server (`opencode serve`) ──────────────
OPENCODE_URL=http://127.0.0.1:4096
# If you started opencode with OPENCODE_SERVER_PASSWORD, give the same here.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Optional: pin the project directory opencode works in.
# OPENCODE_DIRECTORY=/home/me/code/my-project

# opencode's credential file, read for live balances and masked key hints.
# OPENCODE_AUTH_FILE=~/.local/share/opencode/auth.json

# OCB_DATA_DIR=./data
