# systemd user unit: runs `opencode serve` in the background.
#   cp deploy/opencode-serve.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now opencode-serve
#
# Change WorkingDirectory to the project you want the agent to work in.
# Put OPENCODE_SERVER_PASSWORD=... in ~/.config/opencode-pixel.env (chmod 600).
[Unit]
Description=opencode headless server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code
EnvironmentFile=-%h/.config/opencode-pixel.env
ExecStart=/usr/bin/env opencode serve --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
