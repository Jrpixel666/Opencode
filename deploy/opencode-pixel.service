# systemd user unit: runs the opencode-pixel bridge (the phone app's server).
#   cp deploy/opencode-pixel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now opencode-pixel
#   loginctl enable-linger "$USER"   # keep it running when you're logged out
#
# Assumes this repo is cloned to ~/opencode-pixel. Settings go in .env in the repo
# (see .env.example) or in ~/.config/opencode-pixel.env.
[Unit]
Description=opencode-pixel bridge
After=opencode-serve.service
Wants=opencode-serve.service

[Service]
Type=simple
WorkingDirectory=%h/opencode-pixel
EnvironmentFile=-%h/.config/opencode-pixel.env
ExecStart=/usr/bin/env node server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
