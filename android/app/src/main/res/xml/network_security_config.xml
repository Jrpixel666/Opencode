<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS (e.g. Tailscale Serve) is recommended. Plain HTTP is allowed so the app also works
     with a bridge on your home network or tailnet without a certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
